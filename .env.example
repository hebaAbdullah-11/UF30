# Copy to your environment (Vercel project settings, or export locally). Never commit real values.

# Postgres. On Vercel use the Supabase *transaction pooler* URI (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uf30

# Signs the session cookie. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Supabase project (Auth + Storage). The anon key is public by design.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# AI provider used by the server only.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional
LOG_LEVEL=info
