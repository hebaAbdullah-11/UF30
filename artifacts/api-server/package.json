{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:planner": "node --experimental-strip-types --test src/services/planner.test.ts",
    "test:planner:integration": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/services/planner.integration.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:uf30": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/services/uf30-institutions.test.ts",
    "test": "node --experimental-strip-types --test src/services/ai/interactive-flow.test.ts src/services/ai/get-agent-response.test.ts src/services/ai/agent-hierarchy.test.ts src/services/ai/reference-retrieval.test.ts src/services/ai/flowchart-request.test.ts src/services/chat-exchange.test.ts src/services/chat-contract.test.ts src/services/chat-media.test.ts src/services/planner.test.ts src/lib/supabase.test.ts && pnpm run test:uf30"
  },
  "dependencies": {
    "@clerk/express": "^2.1.69",
    "@clerk/shared": "^4.33.0",
    "@google-cloud/storage": "^8.4.0",
    "@huggingface/transformers": "^3.8.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
